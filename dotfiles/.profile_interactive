# Shared interactive setup for Bash and Zsh.

if [ -n "$LOG_DOTFILE_TIMES" ]; then
  log "Start of ~/.profile_interactive"
fi

function alert {
  local msg="$1"
  osascript -e 'display notification "'"$msg"'"'
}

if [[ "$OSTYPE" == "darwin"* ]] && ! type "fzf" > /dev/null 2>&1; then
  echo "WARNING: fzf is not installed"
  echo '  Run `brew install fzf`'
fi

: ${DJR_DOTFILES_DIR:=$HOME/.dotfiles.git}
[ -r "$DJR_DOTFILES_DIR/lib/bash/aliases" ] && source "$DJR_DOTFILES_DIR/lib/bash/aliases"

export EDITOR="vim"

# support colors in less
export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;31m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;44;33m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;32m'

if [ -f ~/.profile_interactive_local ]; then
  . ~/.profile_interactive_local
fi
