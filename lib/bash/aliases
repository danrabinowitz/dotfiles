alias typeless='history 1 | tail -n 20000 | sed "s/.*  //" | sort | uniq -c | sort -g | tail -n 100'

# Project navigation using fzf (already required by the shell setup).
projswitch() {
  local depth="$1" base="$2" target="$3"
  if [ -n "$target" ]; then
    builtin cd "$base/$target"
    return
  fi

  builtin cd "$base" || return
  target=$(find . -type d -maxdepth "$depth" | grep -v '\.git' | fzf) || return
  [ -z "$target" ] || builtin cd "$target"
}

dop() {
  projswitch 2 "$HOME/code/src/DigitalOcean" "$1"
}

ctp() {
  projswitch 10 "$HOME/code/src/DigitalOcean/cthulhu" "$1"
}

# In a one-window, one-pane tmux session, detach rather than exit the session.
exit() {
  if [[ -z $TMUX ]]; then
    builtin exit
    return
  fi

  panes=$(tmux list-panes | wc -l)
  wins=$(tmux list-windows | wc -l)
  count=$(($panes + $wins - 1))
  if [ $count -eq 1 ]; then
    tmux detach
  else
    builtin exit
  fi
}

