# Shared Bash and Zsh aliases and functions. Loaded after PAGER when applicable.

alias rm="rm -i"

# Prefer GNU ls: Homebrew provides gls; Linux normally provides GNU ls.
# Avoid subprocesses such as `ls --version | grep` at shell startup.
ls_cmd=ls
gnu_ls=
case "$OSTYPE" in
  linux*) gnu_ls=1 ;;
esac
if command -v gls >/dev/null 2>&1; then
  ls_cmd=gls
  gnu_ls=1
fi

ls_common="-hbF"
if [ -n "$gnu_ls" ]; then
  export LS_COLORS="di=32:ln=1;31:so=37:pi=1;33:ex=35:bd=37:cd=37:su=37:sg=37:tw=32:ow=32"
  ls_color=' --color=auto'
else
  # BSD ls on macOS.
  export LSCOLORS=cxBxhxDxfxhxhxhxhxcxcx
  ls_color='-G'
fi

alias ls="${ls_cmd} ${ls_common} ${ls_color}"
alias ll="ls -l"
alias l.="ls -d .*"
unset ls_cmd ls_common ls_color gnu_ls

