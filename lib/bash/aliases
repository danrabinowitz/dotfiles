function edit_code {
  if [ "$#" -eq 0 ]; then
    command code .
  else
    command code "$@"
  fi
}

alias vsc=edit_code
alias edit=edit_code
alias e=edit_code

alias beep="echo -ne '\007'"

function cover {
  local t=$(mktemp -t cover)
  go test $COVERFLAGS -coverprofile=$t "$@" \
    && go tool cover -func=$t \
    && unlink $t
}

