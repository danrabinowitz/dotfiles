# Shared PATH setup for Bash and Zsh (under `emulate sh`).

if [ -n "$LOG_DOTFILE_TIMES" ]; then
  log "Start of DJR_DOTFILES_DIR:bash/path"
fi

# Build the path before deduplicating it. The first occurrence wins below.
function _path_prepend {
  export PATH="$1${PATH:+:${PATH}}"
}

function _path_append {
  export PATH="${PATH:+${PATH}:}$1"
}

_path_append /bin:/usr/bin
_path_prepend /usr/local/bin
_path_append /usr/local/sbin:/usr/sbin:/sbin

for _path_dir in /usr/local/share/npm/bin /opt/X11/bin /usr/local/go/bin; do
  [ -d "$_path_dir" ] && _path_append "$_path_dir"
done

[ -d /opt/homebrew/bin ] && _path_prepend /opt/homebrew/bin

# Prepends in this order; later entries take precedence.
for _path_dir in "$HOME/bin" "$HOME/code/bin" "$HOME/rootdir/usr/local/bin" "$HOME/.nix-profile/bin"; do
  [ -d "$_path_dir" ] && _path_prepend "$_path_dir"
done

unset -f _path_prepend _path_append
unset _path_dir

# Deduplicate in-process instead of spawning tr/nl/sort/cut/sed.
# First entry wins; empty fields are dropped.
if [ -n "$ZSH_VERSION" ]; then
  typeset -U path
  PATH=${PATH#:}
  PATH=${PATH%:}
else
  _deduped=
  _rest=$PATH
  while [ -n "$_rest" ]; do
    case "$_rest" in
      *:*) _dir=${_rest%%:*} ; _rest=${_rest#*:} ;;
      *) _dir=$_rest ; _rest= ;;
    esac
    [ -n "$_dir" ] || continue
    case ":${_deduped}:" in
      *":${_dir}:"*) ;;
      *) _deduped=${_deduped:+${_deduped}:}${_dir} ;;
    esac
  done
  PATH=$_deduped
  PATH=${PATH#:}
  PATH=${PATH%:}
  unset _deduped _rest _dir
fi

# Load chruby at top level to preserve its environment and hook registration.
for _chruby_root in /usr/local/share/chruby /opt/homebrew/share/chruby; do
  if [ -r "$_chruby_root/chruby.sh" ]; then
    source "$_chruby_root/chruby.sh"
    [ -r "$_chruby_root/auto.sh" ] && source "$_chruby_root/auto.sh"
  fi
done
unset _chruby_root
